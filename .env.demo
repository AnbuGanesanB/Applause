COMPOSE_PROJECT_NAME=applause-demo

# Versions
POSTGRES_VERSION=15
KEYCLOAK_VERSION=24.0.1

#PROFILE/ENV
SPRING_PROFILES_ACTIVE=native,demo

#Config-server & Details
CONFIG_SERVER_PORT=8888
CONFIG_PATH=file:/app/config-repo
CONFIG_SERVER_URL=http://config-server:8888
CONFIGURATION_IMPORT=optional:configserver:http://config-server:8888

#Discovery-Service & Details
DISCOVERY_SERVICE_PORT=8761
DISCOVERY_SERVICE_HOST=discovery-service
DISCOVERY_SERVICE_URL=http://${DISCOVERY_SERVICE_HOST}:${DISCOVERY_SERVICE_PORT}/eureka/

#--Keycloak-service
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_HOSTNAME=keycloak-service
KEYCLOAK_BASE_URL=http://keycloak-service:8080
KEYCLOAK_TOKEN_ISSUER_URI=http://keycloak-service:8080/realms/Realm_Study
KEYCLOAK_TOKEN_URI=http://keycloak-service:8080/realms/Realm_Study/protocol/openid-connect/token
KEYCLOAK_DEMO_REALMNAME=Realm_Study

# Keycloak - Database configuration (Postgres)
KC_DB=postgres
KC_DB_URL_HOST=keycloak-database
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=password
KC_DB_SCHEMA=public
KEYCLOAK_START_COMMAND=start --http-enabled=true

# PGAdmin
PGADMIN_DEFAULT_EMAIL=pgadmin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# Employee - services
EMPLOYEE_SERVICE_PORT=8050
EMPLOYEE_DB=employee_database
EMPLOYEE_DB_USER=emp_user
EMPLOYEE_DB_PASSWORD=emp_pass
EMPLOYEE_DB_PORT=5434
EMPLOYEE_SERVICE_CLIENT_ID=employee_service
EMPLOYEE_SERVICE_CLIENT_SECRET=imBdba5w1MBmlarVqRP6ywtxX5gbCW1c
EMPLOYEE_SERVICE_DB_URL=jdbc:postgresql://employee-db-service:5432/employee_database?options=-c%20TimeZone=UTC

# Award - services
AWARD_SERVICE_PORT=8060
AWARD_DB=award_database
AWARD_DB_USER=award_user
AWARD_DB_PASSWORD=award_pass
AWARD_DB_PORT=5435
AWARD_SERVICE_DB_URL=jdbc:postgresql://award-db-service:5432/award_database?options=-c%20TimeZone=UTC


# Goody - services
